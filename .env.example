NEXT_PUBLIC_SITE_URL=https://domain.cubixtop.com
# Supabase > Connect > Transaction pooler. Fill in your database password.
# Use the exact supplied host and username; URL-encode special password characters.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Stable 32-byte key as 64 hexadecimal characters. Keep private and backed up.
SETTINGS_ENCRYPTION_KEY=




# Zoho: use the SMTP host shown in your account's Server Configuration Details.
# Use an application-specific password. For port 465 set SMTP_SECURE=true;
# port 587 uses SMTP_SECURE=false with required STARTTLS.
EMAIL_FROM=Cubixtop <info@cubixtop.com>
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@cubixtop.com
SMTP_PASSWORD=

# Configure and select payment gateways in Admin > Payment gateways.
# Supported: Cashfree, Razorpay, Paytm, PayU / PayUMoney, Easebuzz.
# Merchant credentials are encrypted in the private settings store.
# Registrar fallback (or configure NameSilo in Admin)
NAMESILO_API_KEY=

ADMIN_EMAIL=admin@cubixtop.com
DEFAULT_MARKUP_PERCENT=25

# Required on Vercel; optional for local development.
ADMIN_PASSWORD=
# Set true when deployed behind HTTPS
COOKIE_SECURE=false
# DATA_DIRECTORY may point to a persistent private directory; default .local
